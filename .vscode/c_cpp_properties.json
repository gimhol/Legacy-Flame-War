{
  "version": 4,
  "configurations": [
    {
      "name": "native-msvc-x64",
      "compileCommands": "${workspaceFolder}/build/compile_commands.json",
      "includePath": [
        "${workspaceFolder}",
        "${workspaceFolder}/build/godot/host/godot/godot-cpp/gen/include",
        "${env:GODOT_CPP_DIR}/include",
        "${env:GODOT_CPP_DIR}/gdextension",
        "${env:USERPROFILE}/godot-cpp-4.5/include",
        "${env:USERPROFILE}/godot-cpp-4.5/gdextension"
      ],
      "defines": [
        "_CRT_SECURE_NO_WARNINGS",
        "_HAS_EXCEPTIONS=0"
      ],
      "cStandard": "c17",
      "cppStandard": "c++20",
      "intelliSenseMode": "windows-msvc-x64"
    }
  ]
}
